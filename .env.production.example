APP_NAME="San Isidro Clinic"
APP_ENV=production
APP_KEY=REPLACE_WITH_DEPLOYMENT_SECRET
APP_DEBUG=false
APP_URL=https://clinic.example.org
APP_TIMEZONE=Asia/Manila

# Use a dedicated app account; restrict it to this database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=san_isidro_clinic
DB_USERNAME=clinic_app
DB_PASSWORD=REPLACE_WITH_DATABASE_SECRET

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Confirm these host/port settings with your mail provider.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.org
MAIL_PORT=465
MAIL_USERNAME=REPLACE_WITH_MAIL_ACCOUNT
MAIL_PASSWORD=REPLACE_WITH_MAIL_SECRET
MAIL_FROM_ADDRESS=appointments@clinic.example.org
MAIL_FROM_NAME="San Isidro Family Medical Clinic"

LOG_CHANNEL=stack
LOG_LEVEL=warning
